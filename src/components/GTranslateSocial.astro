---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<div class="sprey-header-extra">
  <a class="sprey-site-button" href="https://www.sprey.win/" target="_blank" rel="noopener noreferrer" aria-label="Visit Sprey.win promotional website">Sprey.win <span aria-hidden="true">↗</span></a>
  <Default><slot /></Default>
  <div class="gtranslate_wrapper" aria-label="Translate documentation"></div>
</div>

<script>
  document.querySelectorAll('.sprey-header-extra > a[href^="http"]').forEach((link) => {
    link.setAttribute('target', '_blank');
    link.setAttribute('rel', 'me noopener noreferrer');
  });
</script>

<style>
  .sprey-site-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    min-height: 2.25rem;
    padding: .48rem .8rem;
    border: 1px solid color-mix(in srgb, var(--sprey-purple) 72%, var(--sl-color-gray-4));
    border-radius: 6px;
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: #fff !important;
    font-size: .82rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: 0 3px 12px color-mix(in srgb, var(--sprey-purple) 24%, transparent);
    transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
  }

  .sprey-site-button:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
    box-shadow: 0 5px 16px color-mix(in srgb, var(--sprey-purple) 34%, transparent);
  }

  .sprey-site-button:focus-visible {
    outline: 2px solid var(--sprey-purple-2);
    outline-offset: 3px;
  }

  @media (max-width: 50rem) {
    .sprey-site-button {
      min-height: 2rem;
      padding: .42rem .58rem;
      font-size: .76rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sprey-site-button { transition: none; }
  }

  .gtranslate_wrapper {
    position: relative;
    margin-inline-start: 1rem;
  }

  .gtranslate_wrapper::before {
    content: '';
    position: absolute;
    inset-inline-start: -.85rem;
    top: 50%;
    width: 1px;
    height: 1.6rem;
    background: var(--sl-color-gray-5);
    transform: translateY(-50%);
    pointer-events: none;
  }
</style>
