---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<div class="sprey-header-extra">
  <Default><slot /></Default>
  <div class="gtranslate_wrapper" aria-label="Translate documentation"></div>
</div>

<script>
  document.querySelectorAll('.sprey-header-extra > a[href^="http"]').forEach((link) => {
    link.setAttribute('target', '_blank');
    link.setAttribute('rel', 'me noopener noreferrer');
  });
</script>

<style>
  .gtranslate_wrapper {
    position: relative;
    margin-inline-start: 1rem;
  }

  .gtranslate_wrapper::before {
    content: '';
    position: absolute;
    inset-inline-start: -.85rem;
    top: 50%;
    width: 1px;
    height: 1.6rem;
    background: var(--sl-color-gray-5);
    transform: translateY(-50%);
    pointer-events: none;
  }
</style>
